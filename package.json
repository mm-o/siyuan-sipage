{
  "name": "desk-cards",
  "version": "0.9.6",
  "packageManager": "pnpm@10.33.4",
  "type": "module",
  "description": "思源桌面卡片：自适应卡片（日历 / 天气 / 时钟 / 一言 …）+ 网格自动补位",
  "author": "mm-o",
  "license": "MIT",
  "homepage": "https://github.com/mm-o/desk-cards",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mm-o/desk-cards.git"
  },
  "scripts": {
    "dev": "vite build --watch",
    "release": "node ./release.js",
    "release:manual": "node ./release.js --mode=manual",
    "release:patch": "node ./release.js --mode=patch",
    "release:minor": "node ./release.js --mode=minor",
    "release:major": "node ./release.js --mode=major",
    "build": "vite build",
    "dev:card": "vite build --config vite.dev.config.ts",
    "check:dist": "node tools/verify/check-dist.mjs",
    "check:arch": "node tools/verify/check-arch.mjs",
    "dev:reload": "vite build && node tools/reload.mjs",
    "release:ship": "bash release-ship.sh",
    "check:types": "vue-tsc --noEmit -p tsconfig.json",
    "check:bp": "node tools/verify/check-breakpoints.mjs",
    "check": "pnpm check:types && pnpm check:arch && pnpm check:bp && pnpm build && pnpm check:dist",
    "check:browser": "pnpm dev:card && node tools/verify/shot-deskclock.mjs && node tools/verify/shot-arrange.mjs && node tools/verify/shot-ui.mjs && node tools/verify/shot-theme.mjs && node tools/verify/shot-glass.mjs && node tools/verify/shot-surfaces.mjs && node tools/verify/shot-agenda.mjs && node tools/verify/shot-controls.mjs && node tools/verify/shot-shortcut.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.8.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^9.22.0",
    "fast-glob": "^3.2.12",
    "lucide-vue-next": "^1.0.0",
    "playwright-core": "^1.65.0",
    "rollup-plugin-livereload": "^2.0.5",
    "siyuan": "1.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-plugin-static-copy": "^0.15.0",
    "vite-plugin-zip-pack": "^1.0.5",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "tyme4ts": "^1.5.6"
  },
  "bugs": {
    "url": "https://github.com/mm-o/desk-cards/issues"
  }
}
