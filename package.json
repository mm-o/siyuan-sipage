{
  "name": "siyuan-sipage",
  "version": "1.0.3",
  "packageManager": "pnpm@10.33.4",
  "type": "module",
  "description": "思页（SiPage）——思源插件：把思源的一个页签变成一屏卡片桌面（壁纸 + 16 张活卡片，可拖拽、一键整理、可插进文档）",
  "author": "mm-o",
  "license": "MIT",
  "homepage": "https://github.com/mm-o/siyuan-sipage",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mm-o/siyuan-sipage.git"
  },
  "scripts": {
    "dev": "vite build --watch",
    "release": "node ./release.js",
    "release:manual": "node ./release.js --mode=manual",
    "release:patch": "node ./release.js --mode=patch",
    "release:minor": "node ./release.js --mode=minor",
    "release:major": "node ./release.js --mode=major",
    "build": "vite build",
    "dev:card": "vite build --config vite.dev.config.ts",
    "check:dist": "node tools/verify/check-dist.mjs",
    "check:arch": "node tools/verify/check-arch.mjs",
    "dev:reload": "vite build && node tools/reload.mjs",
    "release:ship": "bash release-ship.sh",
    "check:types": "vue-tsc --noEmit -p tsconfig.json",
    "check:bp": "node tools/verify/check-breakpoints.mjs",
    "check:i18n": "node tools/verify/check-i18n.mjs",
    "check": "pnpm check:types && pnpm check:arch && pnpm check:bp && pnpm check:i18n && pnpm check:css && pnpm build && pnpm check:dist",
    "check:browser": "pnpm dev:card && node tools/verify/shot-deskclock.mjs && node tools/verify/shot-arrange.mjs && node tools/verify/shot-ui.mjs && node tools/verify/shot-theme.mjs && node tools/verify/shot-glass.mjs && node tools/verify/shot-surfaces.mjs && node tools/verify/shot-agenda.mjs && node tools/verify/shot-daily.mjs && node tools/verify/shot-controls.mjs && node tools/verify/shot-shortcut.mjs && node tools/verify/shot-quicknote.mjs",
    "check:css": "node tools/verify/check-css.mjs"
  },
  "keywords": [
    "sipage",
    "思页",
    "siyuan",
    "siyuan-plugin",
    "page",
    "tab",
    "desk",
    "dashboard",
    "widget",
    "card",
    "calendar"
  ],
  "dependencies": {
    "tyme4ts": "^1.5.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.8.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^9.22.0",
    "fast-glob": "^3.2.12",
    "lucide-vue-next": "^1.0.0",
    "playwright-core": "^1.65.0",
    "rollup-plugin-livereload": "^2.0.5",
    "siyuan": "1.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-plugin-static-copy": "^0.15.0",
    "vite-plugin-zip-pack": "^1.0.5",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "bugs": {
    "url": "https://github.com/mm-o/siyuan-sipage/issues"
  }
}
